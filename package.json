{
  "name": "quantum-lens-ai",
  "version": "2.0.0",
  "description": "Quantum Lens AI — Next-Generation Quantum Computing Laboratory & Grounded Pedagogical Platform for Smart India Hackathon (SIH 2026 PS26140)",
  "author": "NVNAGATHARUN",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=2048 ./node_modules/typescript/bin/tsc && node --max-old-space-size=2048 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "test:studio": "node --test tests/studio.test.mjs",
    "test:e2e": "playwright test",
    "build:local": "node --max-old-space-size=2048 ./node_modules/typescript/bin/tsc && node scripts/local-preview.mjs --build-only",
    "preview:local": "node scripts/local-preview.mjs",
    "server": "ts-node --project tsconfig.server.json server/index.ts",
    "server:build": "tsc --project tsconfig.server.json",
    "server:start": "node dist-server/server/index.js",
    "build:full": "npm run server:build && npm run build",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\""
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/katex": "^0.16.8",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "framer-motion": "^10.18.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.47.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-katex": "^3.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.33",
    "prettier": "3.6.2",
    "recharts": "^3.7.0",
    "tailwindcss": "^3.4.1",
    "three": "^0.183.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^8.3.1"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
