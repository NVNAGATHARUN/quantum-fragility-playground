# Backend API base URL (leave empty to use Vite proxy at /api during local dev)
VITE_API_BASE_URL=

# Server port
PORT=4000

# Gemini API key (needed for the AI assistant)
GEMINI_API_KEY=

# Required for production backend authentication. Generate long random values.
JWT_SECRET_KEY=
INSTRUCTOR_INVITE_CODE=
ENVIRONMENT=development

# CORS allowed origin for production (set to your Vercel URL)
ALLOWED_ORIGIN=
# FastAPI accepts a comma-separated list, for example:
# QL_ALLOWED_ORIGINS=https://learn.example.org,https://admin.example.org
QL_ALLOWED_ORIGINS=
